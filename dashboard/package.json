  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "prettier": "^3.9.9",
    "typescript": "^5.9.3",
    "vite": "^8.3.2"
  }
}
