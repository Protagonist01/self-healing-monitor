# Single-host Docker settings. Keep the API private.
ENVIRONMENT=production
ENABLE_DEMO_ENDPOINT=false
# Compose loads API, PostgreSQL and Grafana credentials from .secrets/.
# Generate them with: python scripts/init_secrets.py

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
VITE_HEALER_API_URL=http://localhost:8000
CONFIDENCE_THRESHOLD=0.75
ALLOWED_AUTO_ACTIONS=["RESTART_CONTAINER","NOTIFY_ONLY"]
REQUIRE_HUMAN_APPROVAL=true
# Exact Docker container names; empty denies every container.
DOCKER_ALLOWED_SERVICES=leaky_service,flaky_service
RATE_LIMIT_PER_MINUTE=30
DEDUP_WINDOW_SECONDS=60
MAX_AUTO_EXECUTION_RETRIES=1
VERIFY_DELAY_SECONDS=15
SLACK_WEBHOOK_URL=

# For running Python outside Compose, use development mode and configure:
# HEALER_API_KEY=<a random key>
# AUDIT_BACKEND=sqlite
# SQLITE_PATH=./healer_audit.db
# PROMETHEUS_URL=http://localhost:9090
# LOKI_URL=http://localhost:3100
# CHROMA_DB_DIR=./chroma_db
# RUNBOOKS_DIR=infra/runbooks
